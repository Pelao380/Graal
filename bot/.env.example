# Copia este archivo como .env y pon tu token real AHI, no aqui.
# Este archivo es la plantilla y se sube al repositorio; .env no, porque
# .gitignore lo excluye. El token nunca va en un archivo compartido.
DISCORD_TOKEN=pon_aqui_el_token_de_tu_bot

# Opcional, pero muy recomendable para probar: el ID de tu servidor de
# pruebas. Con esto los comandos de barra aparecen al instante en ese
# servidor; sin esto se registran globalmente y Discord puede tardar hasta una
# hora. El ID se copia con click derecho en el servidor > Copiar ID de
# servidor (hay que activar el Modo desarrollador en los ajustes de Discord).
GUILD_ID=
